    <c:set target="${ideaB2}" property="disponible" value="1" />
    <c:set target="${ideaB2}" property="fecha_fmt" value="12/08/2026" />
    <c:set var="dummyB2" value="${appDemoIdeas.add(ideaB2)}" />

    <%-- Idea Banco 3 --%>
    <jsp:useBean id="ideaB3" class="java.util.HashMap" scope="page" />
    <c:set target="${ideaB3}" property="id" value="3" />
    <c:set target="${ideaB3}" property="codigo" value="BAN-2026-03" />
    <c:set target="${ideaB3}" property="titulo" value="Aplicativo Móvil Accesible para la Inclusión Laboral y Formativa de Personas con Discapacidad Auditiva" />
    <c:set target="${ideaB3}" property="descripcion" value="Software móvil con reconocimiento de voz, transcripción bidireccional inmediata y traducción interactiva a Lengua de Señas Colombiana (LSC) para entornos de trabajo." />
    <c:set target="${ideaB3}" property="objetivo_general" value="Construir una solución de software accesible multiplataforma que facilite la comunicación laboral de trabajadores con discapacidad auditiva mediante procesamiento de lenguaje natural." />
    <c:set target="${ideaB3}" property="tipo_nivel" value="Tecnologico" />
    <c:set target="${ideaB3}" property="tipo_modalidad" value="Desarrollo tecnologico" />
    <c:set target="${ideaB3}" property="linea_investigacion" value="Ingeniería de Software y Accesibilidad" />
    <c:set target="${ideaB3}" property="proponente" value="Martha Comité Grados" />
