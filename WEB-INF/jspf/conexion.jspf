    <c:set var="dummyB3" value="${appDemoIdeas.add(ideaB3)}" />

    <%-- Idea Banco 4 --%>
    <jsp:useBean id="ideaB4" class="java.util.HashMap" scope="page" />
    <c:set target="${ideaB4}" property="id" value="4" />
    <c:set target="${ideaB4}" property="codigo" value="BAN-2026-04" />
    <c:set target="${ideaB4}" property="titulo" value="Modelo Predictivo de Deserción Estudiantil Universitaria usando Técnicas de Machine Learning" />
    <c:set target="${ideaB4}" property="descripcion" value="Análisis de métricas académicas y socioeconómicas institucionales para entrenar modelos supervisados que generen alertas preventivas de deserción temprana." />
    <c:set target="${ideaB4}" property="objetivo_general" value="Entrenar y validar clasificadores de machine learning sobre historiales académicos para predecir oportunamente la probabilidad de deserción en programas de ingeniería." />
