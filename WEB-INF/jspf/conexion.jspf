<%-- 2. ALMACÉN DEMO DE IDEAS DEL BANCO COMPARTIDO --%>
<c:if test="${empty applicationScope.demoIdeasBanco}">
    <jsp:useBean id="appDemoIdeas" class="java.util.ArrayList" scope="application" />

    <%-- Idea Banco 1 --%>
    <jsp:useBean id="ideaB1" class="java.util.HashMap" scope="page" />
    <c:set target="${ideaB1}" property="id" value="1" />
    <c:set target="${ideaB1}" property="codigo" value="BAN-2026-01" />
    <c:set target="${ideaB1}" property="titulo" value="Sistema Inteligente de Monitoreo de Cultivos con IoT y Visión por Computador" />
    <c:set target="${ideaB1}" property="descripcion" value="Implementación de nodos sensoriales ESP32, backend en Python y visión artificial con algoritmos YOLO para detección temprana de plagas, humedad y estrés hídrico en invernaderos protegidos." />
    <c:set target="${ideaB1}" property="objetivo_general" value="Desarrollar e implementar un sistema ciberfísico basado en IoT y procesamiento de imágenes para el monitoreo automatizado de variables microclimáticas y fitosanitarias en cultivos agrícolas." />
    <c:set target="${ideaB1}" property="tipo_nivel" value="Profesional" />
    <c:set target="${ideaB1}" property="tipo_modalidad" value="Desarrollo tecnologico" />
    <c:set target="${ideaB1}" property="linea_investigacion" value="Inteligencia Artificial y Sistemas Embebidos" />
    <c:set target="${ideaB1}" property="proponente" value="Elsa Patricia Carvajal" />
    <c:set target="${ideaB1}" property="proponente_id" value="3" />
    <c:set target="${ideaB1}" property="estado" value="Aprobada" />
    <c:set target="${ideaB1}" property="disponible" value="1" />
    <c:set target="${ideaB1}" property="fecha_fmt" value="10/08/2026" />
    <c:set var="dummyB1" value="${appDemoIdeas.add(ideaB1)}" />

    <%-- Idea Banco 2 --%>
    <jsp:useBean id="ideaB2" class="java.util.HashMap" scope="page" />
    <c:set target="${ideaB2}" property="id" value="2" />
    <c:set target="${ideaB2}" property="codigo" value="BAN-2026-02" />
    <c:set target="${ideaB2}" property="titulo" value="Plataforma Web Descentralizada para Trazabilidad en Cadenas de Suministro con Blockchain" />
    <c:set target="${ideaB2}" property="descripcion" value="Diseño y despliegue de contratos inteligentes en redes Ethereum/Polygon para auditoría inmutable de insumos y productos farmacéuticos desde su producción hasta el consumidor final." />
    <c:set target="${ideaB2}" property="objetivo_general" value="Diseñar una arquitectura descentralizada basada en contratos inteligentes para garantizar la integridad, no repudio y trazabilidad en tiempo real de cadenas de suministro de alta criticidad." />
    <c:set target="${ideaB2}" property="tipo_nivel" value="Profesional" />
    <c:set target="${ideaB2}" property="tipo_modalidad" value="Investigacion" />
    <c:set target="${ideaB2}" property="linea_investigacion" value="Ciberseguridad y Tecnologías Distribuidas" />
    <c:set target="${ideaB2}" property="proponente" value="Fernando Evaluador Pérez" />
    <c:set target="${ideaB2}" property="proponente_id" value="4" />
