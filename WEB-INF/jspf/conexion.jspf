<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%-- 
    ==========================================================================
    SIGRADO - Conexión JSTL 1.2 a Supabase PostgreSQL (Cero Servlets, Cero Scriptlets)
    Reemplaza [TU-PASSWORD], [TU-PROJECT-ID] o tu host asignado en Supabase Settings -> Database.
    Ejemplo Transaction Pooler / Session Pooler o Direct Connection:
    Driver: org.postgresql.Driver
    URL: jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
    o Direct: jdbc:postgresql://db.[TU-PROJECT-ID].supabase.co:5432/postgres?sslmode=require
    ==========================================================================
--%>
<sql:setDataSource var="sigradoDb"
                   driver="org.postgresql.Driver"
                   url="jdbc:postgresql://db.fzxikusnodngkvlztrgv.supabase.co:5432/postgres?sslmode=require"
                   user="postgres"
                   password="[TU-PASSWORD-DE-SUPABASE]" />

