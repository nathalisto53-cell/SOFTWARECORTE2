<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<aside class="app-sidebar">
    <div class="sidebar-header">
        <div class="brand-icon">🌱</div>
        <div class="brand-info">
            <h2>SIGRADO</h2>
            <span>Gestión de Grados</span>
        </div>
    </div>
    
    <div class="sidebar-menu">
        <div class="menu-label">Navegación</div>
        <a href="${pageContext.request.contextPath}/inicio.jsp" class="menu-item ${param.active == 'inicio' ? 'active' : ''}">
            <span class="menu-icon">🏠</span>
            <span>Inicio</span>
        </a>
        
        <%-- Menú Administrador --%>
        <c:if test="${sessionScope.rolActivo == 'administrador'}">
            <div class="menu-label">Administración</div>
            <a href="${pageContext.request.contextPath}/administrador/usuarios.jsp" class="menu-item ${param.active == 'usuarios' ? 'active' : ''}">
                <span class="menu-icon">👥</span>
                <span>Control de Usuarios</span>
            </a>
            <a href="${pageContext.request.contextPath}/administrador/proyectos.jsp" class="menu-item ${param.active == 'proyectos' ? 'active' : ''}">
                <span class="menu-icon">📁</span>
                <span>Proyectos de Grado</span>
            </a>
            <a href="${pageContext.request.contextPath}/administrador/propuestas_banco.jsp" class="menu-item ${param.active == 'propuestas_banco' ? 'active' : ''}">
                <span class="menu-icon">💡</span>
                <span>Aprobar Ideas Banco</span>
            </a>
            <a href="${pageContext.request.contextPath}/administrador/banco.jsp" class="menu-item ${param.active == 'banco' ? 'active' : ''}">
                <span class="menu-icon">📚</span>
                <span>Banco de Ideas</span>
            </a>
            <a href="${pageContext.request.contextPath}/administrador/configuracion.jsp" class="menu-item ${param.active == 'configuracion' ? 'active' : ''}">
                <span class="menu-icon">🗓️</span>
                <span>Calendario (Periodos)</span>
            </a>
            <a href="${pageContext.request.contextPath}/administrador/formatos.jsp" class="menu-item ${param.active == 'formatos' ? 'active' : ''}">
                <span class="menu-icon">📄</span>
                <span>Formatos Institucionales</span>
            </a>
        </c:if>

        <%-- Menú Comité --%>
        <c:if test="${sessionScope.rolActivo == 'comite'}">
            <div class="menu-label">Comité Curricular</div>
            <a href="${pageContext.request.contextPath}/comite/proyectos.jsp" class="menu-item ${param.active == 'proyectos' ? 'active' : ''}">
                <span class="menu-icon">⚖️</span>
                <span>Decisiones Fases (1,3,5,6)</span>
            </a>
            <a href="${pageContext.request.contextPath}/comite/banco.jsp" class="menu-item ${param.active == 'banco' ? 'active' : ''}">
                <span class="menu-icon">📚</span>
                <span>Consultar Banco</span>
            </a>
            <a href="${pageContext.request.contextPath}/comite/usuarios.jsp" class="menu-item ${param.active == 'usuarios' ? 'active' : ''}">
                <span class="menu-icon">👥</span>
                <span>Directorio Docentes</span>
            </a>
        </c:if>

        <%-- Menú Docente --%>
        <c:if test="${sessionScope.rolActivo == 'docente'}">
            <div class="menu-label">Roles Asignados</div>
            <a href="${pageContext.request.contextPath}/docente/director.jsp" class="menu-item ${param.active == 'director' ? 'active' : ''}">
                <span class="menu-icon">🎯</span>
                <span>Docente Director (F2/F4)</span>
            </a>
            <a href="${pageContext.request.contextPath}/docente/evaluador.jsp" class="menu-item ${param.active == 'evaluador' ? 'active' : ''}">
                <span class="menu-icon">📝</span>
                <span>Docente Evaluador (F3/F5)</span>
            </a>
            <a href="${pageContext.request.contextPath}/docente/codirector.jsp" class="menu-item ${param.active == 'codirector' ? 'active' : ''}">
                <span class="menu-icon">🤝</span>
                <span>Docente Codirector</span>
            </a>
            <div class="menu-label">Banco de Ideas</div>
            <a href="${pageContext.request.contextPath}/docente/banco.jsp" class="menu-item ${param.active == 'banco' or param.active == 'propuestas_banco' ? 'active' : ''}">
                <span class="menu-icon">💡</span>
                <span>Banco de Ideas</span>
            </a>
        </c:if>

        <%-- Menú Estudiante --%>
        <c:if test="${sessionScope.rolActivo == 'estudiante'}">
            <div class="menu-label">Mi Grado</div>
            <a href="${pageContext.request.contextPath}/estudiante/proyecto.jsp" class="menu-item ${param.active == 'proyecto' ? 'active' : ''}">
                <span class="menu-icon">🎓</span>
                <span>Mi Proyecto de Grado</span>
            </a>
            <a href="${pageContext.request.contextPath}/estudiante/seguimiento.jsp" class="menu-item ${param.active == 'seguimiento' ? 'active' : ''}">
                <span class="menu-icon">🗺️</span>
                <span>Mapa de Fases y Turno</span>
            </a>
            <a href="${pageContext.request.contextPath}/estudiante/banco.jsp" class="menu-item ${param.active == 'banco' ? 'active' : ''}">
                <span class="menu-icon">💡</span>
                <span>Banco de Ideas Disponibles</span>
            </a>
            <a href="${pageContext.request.contextPath}/estudiante/versiones.jsp" class="menu-item ${param.active == 'versiones' ? 'active' : ''}">
                <span class="menu-icon">📑</span>
                <span>Historial de Entregas</span>
            </a>
        </c:if>

        <div class="menu-label">Común</div>
        <a href="${pageContext.request.contextPath}/comun/calendario.jsp" class="menu-item ${param.active == 'calendario' ? 'active' : ''}">
            <span class="menu-icon">📅</span>
            <span>Calendario del Periodo</span>
        </a>
        <a href="${pageContext.request.contextPath}/comun/formatos.jsp" class="menu-item ${param.active == 'formatos_comun' ? 'active' : ''}">
            <span class="menu-icon">📥</span>
            <span>Descargar Formatos</span>
        </a>
    </div>
</aside>
