<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<header class="app-topbar">
    <div class="topbar-left">
        <h1 class="page-title">${empty pageTitle ? 'SIGRADO' : pageTitle}</h1>
    </div>
    
    <div class="topbar-right">
        <%-- Si el usuario tiene más de un rol asignado, botón para cambiar rol --%>
        <c:if test="${not empty sessionScope.rolesUsuario and fn:length(sessionScope.rolesUsuario) > 1}">
            <a href="${pageContext.request.contextPath}/cambiar_rol.jsp" class="btn btn-outline btn-sm">
                🔄 Cambiar Rol
            </a>
        </c:if>
        
        <div class="user-badge">
            <div class="user-avatar">
                ${fn:substring(sessionScope.usuario.nombres, 0, 1)}
            </div>
            <div class="user-meta">
                <span class="user-name">${sessionScope.usuario.nombres} ${sessionScope.usuario.apellidos}</span>
                <span class="user-role-chip">Rol: ${sessionScope.rolActivo}</span>
            </div>
        </div>
        
        <a href="${pageContext.request.contextPath}/perfil.jsp" class="btn btn-outline btn-sm" title="Editar Perfil">
            👤 Perfil
        </a>
        <a href="${pageContext.request.contextPath}/logout.jsp" class="btn btn-outline btn-sm" style="color: #ef4444; border-color: #fecaca;" title="Cerrar Sesión">
            🚪 Salir
        </a>
    </div>
</header>
